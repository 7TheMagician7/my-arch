input {
	keyboard {
		xkb {
			layout "br"
      variant "abnt2"
		}
	}
}

environment {
  GTK_IM_MODULE "wayland"
  XMODIFIERS "@im=ibus"
  QT_IM_MODULES "wayland;ibus"
  QT_IM_MODULE "ibus"
}

window-rule {
	match app-id="firefox"
	open-maximized true
}

window-rule {
	match app-id="steam"
	open-maximized true
}

window-rule {
	match app-id="heroic"
	open-maximized true
}

window-rule {
  match app-id="org.gnome.Nautilus"
  open-floating false
  open-maximized true
}

window-rule {
	match app-id="com.mitchellh.ghostty"
	open-maximized true
}

window-rule {
  match app-id="Spotify"
  open-maximized true
}

window-rule {
  match app-id="com.microsoft.VSCode"
  open-maximized true
}

spawn-at-startup "ibus-daemon" "-drx"

include optional=true "binds.kdl"
